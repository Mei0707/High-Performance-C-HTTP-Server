{
  "mode": "soak",
  "architecture": "reactor",
  "topology": "Separate containers and disjoint CPU sets on ONE Linux VM; shared kernel, memory, and network",
  "host_idle_sleep_assertion": false,
  "server_cpus": [
    0,
    1
  ],
  "client_cpus": [
    2,
    3
  ],
  "image": "pulsehttp-experiments",
  "server_command": [
    "docker",
    "run",
    "-d",
    "--name",
    "pulse-experiment-8c711874c0-server",
    "--network",
    "pulse-experiment-8c711874c0-net",
    "--network-alias",
    "server",
    "--cpuset-cpus",
    "0-1",
    "--pids-limit",
    "4096",
    "--memory",
    "512m",
    "--ulimit",
    "nofile=65536:65536",
    "-v",
    "/home/runner/work/High-Performance-C-HTTP-Server/High-Performance-C-HTTP-Server:/src:ro",
    "-v",
    "/home/runner/work/High-Performance-C-HTTP-Server/High-Performance-C-HTTP-Server/benchmarks/reports/hosted/reactor/server:/results",
    "pulsehttp-experiments",
    "python3",
    "benchmarks/experiments/server_monitor.py",
    "--output",
    "/results",
    "--",
    "build-experiment/pulsehttp_server",
    "--address",
    "0.0.0.0",
    "--document-root",
    "www",
    "--workers",
    "1",
    "--queue-capacity",
    "16",
    "--max-connections",
    "4096",
    "--max-requests",
    "1000000",
    "--idle-timeout-ms",
    "300000"
  ],
  "client_command": [
    "docker",
    "run",
    "--rm",
    "--name",
    "pulse-experiment-8c711874c0-client",
    "--network",
    "pulse-experiment-8c711874c0-net",
    "--cpuset-cpus",
    "2-3",
    "--pids-limit",
    "256",
    "--memory",
    "512m",
    "--ulimit",
    "nofile=65536:65536",
    "-v",
    "/home/runner/work/High-Performance-C-HTTP-Server/High-Performance-C-HTTP-Server:/src:ro",
    "-v",
    "/home/runner/work/High-Performance-C-HTTP-Server/High-Performance-C-HTTP-Server/benchmarks/reports/hosted/reactor/client:/results",
    "pulsehttp-experiments",
    "python3",
    "benchmarks/experiments/client.py",
    "soak",
    "--host",
    "server",
    "--output",
    "/results",
    "--connections",
    "8",
    "--duration",
    "1800",
    "--phase-seconds",
    "30",
    "--overload-connections",
    "128"
  ]
}
